# -------------------------------------
# DATABASE (from Supabase)
# -------------------------------------
# Go to your Supabase project -> Project Settings -> Database -> Connection string
# These are optional — the app runs in demo mode without them
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Prisma connection strings (required only if using Prisma CLI)
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# -------------------------------------
# AUTHENTICATION (NextAuth v5)
# -------------------------------------
# A secret string used to sign tokens. Generate one: https://generate-secret.vercel.app/
AUTH_SECRET=""

# Google OAuth credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -------------------------------------
# APP
# -------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -------------------------------------
# PAYMENTS (Stripe) — optional, features disabled if not set
# -------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# -------------------------------------
# EMAIL (Resend) — optional, features disabled if not set
# -------------------------------------
RESEND_API_KEY=""
FROM_EMAIL="noreply@outbackconnections.com.au"

# -------------------------------------
# ADZUNA (syndicated job ads) — optional, cron no-ops if not set
# Register (free) at https://developer.adzuna.com/
# -------------------------------------
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Shopify sales sync (optional; replaces the monthly CSV upload). Admin API token needs read_reports.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# -------------------------------------
# DIGITAL SERVICES (websites / quote forms / care) — all optional
# -------------------------------------
# Public /digital-services page and its nav links: off unless exactly "on".
DIGITAL_SERVICES_PUBLIC=""
# Josh's Supabase auth user id (uuid). The only account allowed into
# /dashboard/owner. Missing or malformed = nobody gets in.
DIGITAL_SERVICES_OWNER_USER_ID=""
# Where new-enquiry alerts go (reference + link only). Falls back to NOTIFICATION_EMAIL.
DIGITAL_SERVICES_ALERT_TO=""

# Digital services outreach sender (not help@). Named explicitly; counts as
# verified only once the owned-inbox send/reply test has passed (YYYY-MM-DD).
DIGITAL_SERVICES_OUTREACH_SENDER=
DIGITAL_SERVICES_OUTREACH_SENDER_VERIFIED_ON=
